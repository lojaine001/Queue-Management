# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iqms
DB_USER=postgres
# Required: no service has a default password any more; they stop at startup without it.
DB_PASSWORD=change-me
# API connection pool (all optional). DB_POOL_MIN connections stay open; bursts may open
# up to DB_POOL_MAX; a request waits DB_POOL_WAIT_SEC for a free one, then gets 503.
# Every query stops after DB_STATEMENT_TIMEOUT_MS. /health shows the pool's state.
# DB_POOL_MIN=5
# DB_POOL_MAX=10
# DB_POOL_WAIT_SEC=5
# DB_STATEMENT_TIMEOUT_MS=15000

# ── API key ───────────────────────────────────────────────────────────────────
# Required. The API refuses to start without it. Needed (X-API-Key header) for
# the endpoints that change data: /set-lanes, /alert-response, /push-subscribe,
# /push-unsubscribe. Read-only endpoints stay open. tools\install.ps1 fills in a
# random value; never commit it or put it in the web app's JavaScript.
IQMS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Other websites allowed to call the API from a browser, comma-separated, e.g.
# https://example.com,https://other.example. Empty = none (the default, and all
# that is needed: the web app is served from the same address as /api by Caddy;
# native apps and scripts are not affected by CORS). '*' is refused.
CORS_ALLOWED_ORIGINS=

# ── Shop hours ────────────────────────────────────────────────────────────────
SHOP_OPEN=8
SHOP_CLOSE=21
# Per-day overrides (JSON, weekday 0=Mon … 6=Sun). Only keys that differ from defaults are needed.
SHOP_SCHEDULE_OVERRIDE={"6": {"close_hour": 13, "close_minute": 0}}

# ── Prediction buckets & horizon ──────────────────────────────────────────────
BUCKET_MINUTES=3
FORECAST_HORIZON_MINUTES=30
LOOKBACK_MINUTES=30
ROLLING_WINDOW_MINUTES=30
MIN_REAL_DAYS_FOR_SIM=14

# ── Wait model ────────────────────────────────────────────────────────────────
MAX_QUEUE_PER_LANE=20
MAX_WAIT_MIN=60
# Dwell/service time priors — corrected at runtime by snapshot avg when available
DEFAULT_DWELL_MIN=3.0
DWELL_MIN_FLOOR=1.0
DWELL_MAX_CAP=10.0
DEFAULT_LANES=2
SNAPSHOT_MAX_AGE_MIN=30
# Cross-correlation max lag for shop-time estimation (minutes)
SHOP_TIME_MAX_LAG_MIN=120

# ── Training defaults ─────────────────────────────────────────────────────────
DATA_SINCE_DEFAULT_DAYS=14

# ── Ensemble weights ──────────────────────────────────────────────────────────
W_PROPHET=0.40
W_LSTM=0.30
W_XGB=0.30
MODEL_MAX_AGE_HOURS=24

# ── Simulator backend ─────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
FRONTEND_PORT=8081

BROWSING_GAP_MIN=25
CHECKOUT_SERVICE_MIN=2.0

# ── Display tweaks ────────────────────────────────────────────────────────────
# Shift Prophet trace in "Raw Data vs Model Predictions" chart (minutes).
# +120 compensates for raw arrival timestamps stored in local time instead of UTC.
PROPHET_DISPLAY_SHIFT_MIN=0
# Dashboard page auto-refresh and data-cache TTL now follow the "Interval (min)"
# scheduler control in the UI (sched_interval) instead of a fixed env var.

# ── Camera app logs (Head-Detector, entrance app) ─────────────────────────────
# LOGs/*.log rotate at LOG_MAX_MB, keeping LOG_BACKUP_COUNT old copies.
# LOG_CONSOLE_LEVEL: unset = everything in a visible console window, only
# WARNING and above when the output is redirected to a file by start_all.ps1.
# LOG_MAX_MB=50
# LOG_BACKUP_COUNT=3
# LOG_CONSOLE_LEVEL=

# ── Docker only (deploy/docker/README.md) ────────────────────────────────────
# Ignored by the Windows setup. COMPOSE_PROFILES makes `docker compose up -d` also
# start the cameras and the ngrok tunnel.
# COMPOSE_PROFILES=cameras,tunnel
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
# DB_HOST_PORT=5432

# ── Health limits for /health/workers (seconds; optional, defaults shown) ────
# HEALTH_CAMERA_MAX_AGE_SEC=60
# HEALTH_SCHEDULER_MAX_AGE_SEC=120
# HEALTH_PUSH_MAX_AGE_SEC=120
# HEALTH_FORECAST_MAX_AGE_SEC=      (default: 3 forecast intervals, at least 600)

# ── Camera ids, as each camera writes them (its config.yml) ─────────────────
# Used by the forecast (CAM_ID = entrance) and /health/workers; they must match.
# CAM_ID=Bosch_Camera_Entrance
# CHECKOUT_CAM_ID=Bosch_Camera_exit
